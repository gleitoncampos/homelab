---
# Respostas do bootstrap — a FONTE ÚNICA da configuração deste homelab.
#
# Gerado em @@DATA@@ por IaC/bootstrap/bootstrap.py.
# NÃO versionado (.gitignore). Nenhum segredo entra aqui: senhas e tokens vão
# direto para o vault cifrado.
#
# Deste arquivo derivam, por `make bootstrap`:
#
#   inventories/{prod,dev}/hosts.ini      IPs de HOJE (alcançabilidade)
#   terraform/proxmox/terraform.tfvars    IPs-ALVO (onde as VMs serão criadas)
#   .githooks/secret-patterns.local.txt   hostnames e domínio, para o gate
#   inventories/*/group_vars/all/vault.yml (só a parte não-secreta)
#   inventories/*/group_vars/all/99-local.yml  usuário de sistema dos nós
#
# ⚠️ Editar aqui e rodar `make bootstrap` de novo REGENERA os alvos. Editar um
# alvo à mão funciona até a próxima execução sobrescrever. A fonte é esta.

# =============================================================================
# Identidade
# =============================================================================
dominio: @@DOMINIO@@
admin_user: @@ADMIN_USER@@
email_alerta: @@ADMIN_EMAIL@@
ssh_user: @@SSH_USER@@

# Hostnames que o gate deve barrar em arquivo versionado, além dos nós Proxmox
# declarados em `nos:`. Acrescente NAS, firewall, access point.
outros_hostnames: []

wifi:
  main: homelab
  iot: homelab-iot
  media: homelab-media
  guest: homelab-guest

# =============================================================================
# Rede de HOJE — como o Ansible alcança os hosts
# =============================================================================
# São os endereços reais, agora. Se um host não existe ainda, deixe vazio: o
# hosts.ini gerado o deixa comentado, em vez de inventar um IP.
rede_atual:
  # Quem roteia hoje. Registrado por ser topologia útil; nenhum playbook o
  # consome diretamente.
  gateway: @@ATUAL_GATEWAY@@
  # NTP interno ligado (não vazio) ou não. A fonte de cada host é o gateway
  # da rede dele. Vazio = só as fontes públicas do ntp.br, que entram como
  # fallback de qualquer forma.
  ntp_interno: @@ATUAL_NTP@@
  manager: @@ATUAL_MANAGER@@
  worker: @@ATUAL_WORKER@@
  hypervisor1: @@ATUAL_HV1@@
  hypervisor2: @@ATUAL_HV2@@
  omv: @@ATUAL_OMV@@
  opnsense: @@ATUAL_OPNSENSE@@
  openwrt: @@ATUAL_OPENWRT@@
  dev: @@ATUAL_DEV@@

# =============================================================================
# Nós Proxmox
# =============================================================================
nos:
  primario:
    nome: @@HV1_NOME@@
  secundario:
    nome: @@HV2_NOME@@

# Endereço PCI da NIC de WAN em passthrough. Descubra com `lspci` no nó
# primário. Valor errado aqui cria a VM do firewall sem WAN.
opnsense_wan_pci_id: "0000:05:00.0"

# Endereço PCI da SEGUNDA NIC de WAN (CLARO) em passthrough. Descubra com
# `lspci` no nó primário. Valor errado aqui cria a VM do firewall sem a 2ª WAN.
opnsense_wan2_pci_id: "0000:04:00.0"

# Endereço PCI da controladora SATA em passthrough para a VM do NAS. Descubra
# com `lspci` no nó SECUNDÁRIO — é outro host e quase certamente outro endereço.
# Valor errado aqui cria a VM do NAS sem disco de dados nenhum, e ela sobe
# assim mesmo: as montagens estão declaradas com `nofail`, então a falta some
# em vez de travar o boot.
omv_hba_pci_id: "0000:05:00.0"

# =============================================================================
# Proxmox — o que o 00-proxmox-setup.yml precisa saber
# =============================================================================
# As quatro entram no [all:vars] do hosts.ini gerado. Nenhuma tem default no
# playbook, de propósito: cada uma delas, errada e silenciosa, produz um dano
# que só aparece longe daqui — backup salvo no storage errado, hipervisor fora
# da rede, NIC de WAN entrando na bridge da LAN.
proxmox:
  # Id do storage de backup em CADA nó (o nome que `pvesm status` mostra ali).
  # Um por hipervisor: o share do NAS é o mesmo, mas cada nó o registra com o
  # próprio id. O valor é usado por 00-proxmox-setup.yml, que declara o storage,
  # e por 06-backup.yml, que agenda o vzdump contra ele — no mesmo host.
  backup_storage_primario: "@@BACKUP_STORAGE_1@@"
  backup_storage_secundario: "@@BACKUP_STORAGE_2@@"
  # Nome do compartilhamento CIFS no NAS (campo `share` do storage.cfg).
  backup_share: "@@BACKUP_SHARE@@"
  # VMIDs que entram no backup agendado. Lista vazia = 06-backup.yml aborta,
  # que é melhor do que salvar o convidado errado e reportar sucesso.
  backup_vmids: []
  # Interface física de WAN, EXCLUÍDA da bridge vmbr0 porque é dedicada à VM do
  # firewall via passthrough. Vazio = todas as interfaces físicas entram na
  # bridge.
  wan_interface: "@@WAN_IFACE@@"

# =============================================================================
# Rede-ALVO — o plano de VLANs
# =============================================================================
# Endereços-alvo dos convidados que o Terraform cria, e o gateway da VLAN 20.
# O plano de VLANs em si NÃO mora aqui: vive em
# inventories/<env>/group_vars/network/99-local.yml, editado no passo 7 da
# instalação. Uma cópia dele neste arquivo não era lida por ninguém e já
# divergia do plano real.
rede_alvo:
  cidr: 24
  gateway: "@@ALVO_PREFIXO@@.20.1"
  manager: "@@ALVO_PREFIXO@@.20.10"
  worker: "@@ALVO_PREFIXO@@.20.11"
  omv: "@@ALVO_PREFIXO@@.20.15"
  dev: "@@ALVO_PREFIXO@@.20.20"
