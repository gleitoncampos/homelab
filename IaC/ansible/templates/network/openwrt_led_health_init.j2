#!/bin/sh /etc/rc.common
# =============================================================================
# Init procd do led-health. RENDERIZADO POR ANSIBLE -- nao editar no
# equipamento.
# =============================================================================
# ⚠️ START=97 NAO E ARBITRARIO, e baixar esse numero quebra o sinal de forma
# silenciosa. A ordem de boot que importa:
#
#   /etc/init.d/done  START=95  chama `set_state done` do /etc/diag.sh, que
#                               apaga o LED de boot e acende o `led-running`
#   /etc/init.d/led   START=96  aplica as seccoes `config led` do
#                               /etc/config/system (e o que mantem os LEDs de
#                               atividade wifi mudos)
#   led-health        START=97  assume o painel
#
# Subir antes de 97 faz um dos dois sobrescrever o nosso estado, e o painel
# mente ate a primeira transicao -- ou ate a reafirmacao, um minuto depois.
#
# STOP=10 para encerrar cedo no desligamento: o trap do script restaura o azul
# fixo, e queremos isso ANTES de a rede cair, nao depois.
# =============================================================================

START=97
STOP=10
USE_PROCD=1

PROG="{{ openwrt_led_health_path | default('/usr/bin/led-health') }}"

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh "$PROG"
	# respawn <limiar> <espera> <max_falhas>; 0 falhas = tentar para sempre.
	# Um daemon morto congela o painel na ultima cor -- inclusive no branco,
	# que afirma saude. Desistir de respawnar seria desistir do sinal.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
