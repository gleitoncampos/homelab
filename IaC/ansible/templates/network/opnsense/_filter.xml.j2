{# Regras de filtro. Política de segurança: vale para prod e dev.
   Campos por regra variam (o OPNsense só grava o que a GUI expõe para cada
   tipo de ação/estado), por isso o laço interno itera as chaves do próprio
   dado em vez de uma lista fixa — preserva o conjunto e a ordem exatos de
   cada regra sem introduzir elemento que o baseline não tem. #}
      <Filter version="1.0.4" description="Firewall rules (new)">
        <rules>
{% for r in opnsense_rules %}
          <rule uuid="{{ r.uuid }}">
{% for campo in r if campo != 'uuid' %}
{% if r.uuid == '3aacd6cd-3bd9-4498-8419-d3163ee495b1' and campo == 'destination_net' %}
            <destination_net>{{ lan_ipaddr }}</destination_net>
{% else %}
            <{{ campo }}>{{ r[campo] }}</{{ campo }}>
{% endif %}
{% endfor %}
          </rule>
{% endfor %}
{#
  ===========================================================================
  REGRAS GERADAS A PARTIR DE `politica`
  ===========================================================================
  As regras acima são escritas à mão em `opnsense_rules` e são POLÍTICA de
  segurança genérica (blocklists, anti-portscan, evasão de DNS). As de baixo
  são derivadas da topologia: quem alcança quem. Misturar as duas na mesma
  lista seria pedir que alguém mantivesse à mão N regras por VLAN e as
  mantivesse coerentes entre si — foi assim que as seis VLANs ficaram sem
  NENHUMA regra de passagem enquanto oito regras de bloqueio as citavam.

  Cada VLAN vira, nesta ordem de `sequence` (o `quick` faz a primeira que
  casar decidir):

    38  pass   exceção por HOST (`politica.excecoes`)
    40  pass   cada rede do lab em `alcanca`
    45  block  portas de gerência no firewall e em rede privada  (se !gerencia)
    50  block  cada outra rede do lab
    60  pass   qualquer destino                         (se internet: true)

  A ordem é o desenho inteiro:

    38 antes de tudo — a exceção é a regra mais específica do conjunto (um
                      host, não uma rede), então decide primeiro. Em
                      particular ela vence o bloqueio de gerência de 45, que é
                      o que permite `gerencia: false` na VLAN inteira com o
                      host de administração de fora da restrição.
    40 antes de 45  — a permissão ESPECÍFICA vence a restrição genérica.
                      Management_Ports contém 80 e 443, então um bloqueio de
                      gerência antes das liberações mataria HTTP entre VLANs
                      que `alcanca` liberou de propósito: o Home Assistant na
                      20 não falaria com o dispositivo na 40, e a TV na 60 não
                      abriria o serviço de mídia na 20.
    40 antes de 50  — é o que faz a exceção de `alcanca` valer.
    50 antes de 60  — impede a saída para a internet de virar saída para o lab.

  Inverter qualquer par transforma a matriz em algo mais permissivo ou mais
  quebrado, com o MESMO conjunto de regras. Só a `sequence` denuncia.

  ⚠️ `alcanca` é DIRECIONAL. O pf é com estado: liberar 30 -> 20 já traz a
  resposta de volta. Não existe, e não deve existir, regra no sentido inverso.

  UUID vem de `to_uuid` sobre uma chave estável (a VLAN, o tipo e o destino),
  e NÃO de sorteio: UUID é identidade neste config, e um novo a cada render
  faria o OPNsense ver regra nova toda vez.
#}
{% macro regra_politica(chave, seq, acao, iface, destino, porta, descricao, origem=none) %}
          <rule uuid="{{ ('politica:' ~ chave) | to_uuid }}">
            <enabled>1</enabled>
            <statetype>keep</statetype>
            <state-policy/>
            <sequence>{{ seq }}</sequence>
            <action>{{ acao }}</action>
            <quick>1</quick>
            <interfacenot>0</interfacenot>
            <interface>{{ iface }}</interface>
            <direction>in</direction>
            <ipprotocol>inet</ipprotocol>
            <protocol>{{ 'tcp' if porta else 'any' }}</protocol>
            <icmptype/>
            <icmp6type/>
            <source_net>{{ origem | default(iface, true) }}</source_net>
            <source_not>0</source_not>
            <source_port/>
            <destination_net>{{ destino }}</destination_net>
            <destination_not>0</destination_not>
            <destination_port>{{ porta }}</destination_port>
            <divert-to/>
            <gateway/>
            <replyto/>
            <disablereplyto>0</disablereplyto>
            <log>{{ 1 if acao == 'block' else 0 }}</log>
            <allowopts>0</allowopts>
            <nosync>0</nosync>
            <nopfsync>0</nopfsync>
            <statetimeout/>
            <udp-first/>
            <udp-multiple/>
            <udp-single/>
            <max-src-nodes/>
            <max-src-states/>
            <max-src-conn/>
            <max/>
            <max-src-conn-rate/>
            <max-src-conn-rates/>
            <overload/>
            <adaptivestart/>
            <adaptiveend/>
            <prio/>
            <set-prio/>
            <set-prio-low/>
            <tag/>
            <tagged/>
            <tcpflags1/>
            <tcpflags2/>
            <tcpflags_any>0</tcpflags_any>
            <categories/>
            <sched/>
            <tos/>
            <shaper1/>
            <shaper2/>
            <description>{{ descricao | e }}</description>
          </rule>
{% endmacro %}
{# `todas_lab` é o universo de destinos internos: a rede plana de resgate mais
   uma por VLAN. Sai de `vlans`, então uma VLAN nova entra no bloqueio das
   outras SOZINHA — o modo de falha oposto (VLAN nova nascer alcançável por
   todo mundo porque ninguém lembrou de acrescentá-la a uma lista) é o que
   esta derivação existe para impedir. #}
{% set todas_lab = ['lan'] %}
{% for v in vlans %}
{% set _ = todas_lab.append('vlan' ~ v.tag) %}
{% endfor %}
{% for vlan in vlans %}
{% set eu = 'vlan' ~ vlan.tag %}
{% set pol = vlan.politica %}
{% set permitidas = [] %}
{% for d in pol.alcanca %}
{% set _ = permitidas.append('lan' if d == 'lan' else 'vlan' ~ d) %}
{% endfor %}
{% set bloqueadas = todas_lab | reject('equalto', eu) | reject('in', permitidas) | list %}
{#   Exceções por HOST. `origem` é passado verbatim para `source_net`, então
     aceita IP, CIDR ou nome de alias — alias é o mais robusto quando forem
     mais de um endereço.

     ⚠️ ISTO NÃO É FRONTEIRA DE SEGURANÇA. A origem é um endereço IP, e
     qualquer aparelho no mesmo segmento L2 pode assumi-lo: o pf não filtra
     por MAC, e o switch não impede um cliente de se autoconfigurar com o
     endereço do vizinho. Serve para NÃO abrir a rede inteira, que é ganho
     real, e não para impedir quem já está dentro da VLAN de origem.

     Fronteira de verdade seria rede própria para o host de administração. #}
{% for ex in pol.excecoes | default([]) %}
{% for destino_ex in ex.alcanca %}
{{ regra_politica(eu ~ ':excecao:' ~ ex.origem ~ ':' ~ destino_ex, 38, 'pass',
                  eu, 'lan' if destino_ex == 'lan' else 'vlan' ~ destino_ex,
                  '', vlan.name ~ ' > excecao ' ~ (ex.descr | default(ex.origem)),
                  ex.origem) }}
{% endfor %}
{% endfor %}
{% for destino in permitidas %}
{{ regra_politica(eu ~ ':pass-lab:' ~ destino, 40, 'pass', eu, destino, '',
                  vlan.name ~ ' > alcanca ' ~ destino) }}
{% endfor %}
{% if not pol.gerencia %}
{#   Dois destinos, e nenhum é `any`. Management_Ports contém 80 e 443: com
     destino `any` esta regra tiraria a web INTEIRA da VLAN em vez do acesso à
     GUI — era o defeito da regra manual e8d7c6b5, removida.

     `(self)` é o próprio firewall, e não sai de REDES_PRIVADAS: o IP dele na
     interface desta VLAN pode estar fora da RFC 1918 conforme o
     endereçamento, e o bloqueio da GUI não pode depender disso.
     REDES_PRIVADAS cobre todo o resto que seja interno — inclusive faixa
     privada que não seja VLAN nenhuma daqui, que os bloqueios de rede do lab
     (sequence 50) não alcançam. #}
{{ regra_politica(eu ~ ':block-gerencia-self', 45, 'block', eu, '(self)',
                  'Management_Ports',
                  vlan.name ~ ' > bloqueia gerencia do firewall') }}
{{ regra_politica(eu ~ ':block-gerencia-privadas', 45, 'block', eu,
                  'REDES_PRIVADAS', 'Management_Ports',
                  vlan.name ~ ' > bloqueia gerencia em rede privada') }}
{% endif %}
{% for destino in bloqueadas %}
{{ regra_politica(eu ~ ':block-lab:' ~ destino, 50, 'block', eu, destino, '',
                  vlan.name ~ ' > bloqueia ' ~ destino) }}
{% endfor %}
{% if pol.internet %}
{{ regra_politica(eu ~ ':pass-internet', 60, 'pass', eu, 'any', '',
                  vlan.name ~ ' > internet') }}
{% endif %}
{% endfor %}
        </rules>
        <snatrules/>
        <npt/>
        <onetoone/>
      </Filter>
