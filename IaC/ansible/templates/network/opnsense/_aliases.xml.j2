{# Aliases de firewall. Blocklists públicas e grupos de porta são política.
   O laço interno itera as chaves do próprio dado, não uma lista fixa: uma
   lista fixa descarta em silêncio qualquer campo que não conste nela — foi
   o defeito achado em _filter.xml.j2 e vale o mesmo aqui, mesmo as 20
   aliases de hoje tendo forma idêntica. #}
      <Alias version="1.0.1" description="Firewall aliases">
        <geoip>
          <url/>
        </geoip>
        <aliases>
{% for a in opnsense_aliases %}
          <alias uuid="{{ a.uuid }}">
{% for campo in a if campo != 'uuid' %}
{% if a.name == 'DNS_REDIRECT_BYPASS' and campo == 'content' %}
{#  Managers do Swarm entram sempre: o Traefik roda neles e o DNS-01 da
    Cloudflare precisa do SOA público, que o Unbound não devolve para o
    domínio do homelab (override curinga). `_dns_bypass_managers` vem do
    inventário, no 01-opnsense-setup.yml (13/10/2026). #}
            <content>{{ ((dns_redirect_bypass_ips | default([])) + (_dns_bypass_managers | default([]))) | unique | join('\n') }}</content>
{% else %}
            <{{ campo }}>{{ a[campo] }}</{{ campo }}>
{% endif %}
{% endfor %}
          </alias>
{% endfor %}
        </aliases>
      </Alias>
