config wifi-device 'radio0'
	option type 'mac80211'
	option channel 'auto'
	option band '2g'
	option htmode 'HT20'
	option cell_density '0'
	option airtime_fairness '1'
	option country 'BR'
	option basic_rate '12000'
	option powersave '0'
	option beacon_int '100'
	option probe_resp_offload '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option channel 'auto'
	option band '5g'
	option htmode 'VHT80'
	option cell_density '0'
	option airtime_fairness '1'
	option country 'BR'
	option basic_rate '24000'
	option powersave '0'
	option beacon_int '100'
	option probe_resp_offload '1'

# =====================================================================
# VLAN 30 - MAIN (Dual-Band 2.4GHz + 5GHz, Visivel, Fast Roaming 802.11k/v)
# =====================================================================
config wifi-iface 'wifi_main_2g'
	option device 'radio0'
	option mode 'ap'
	option network 'vlan30'
	option ssid '{{ wifi_main_ssid | default("Homelab-Main") }}'
	option encryption 'sae-mixed'
	option key '{{ wifi_main_password }}'
	option ieee80211w '1'
	option ieee80211k '1'
	option ieee80211v '1'
	option hidden '0'
	option isolate '0'
	option mcast_to_unicast '1'
	option disassoc_low_ack '1'

config wifi-iface 'wifi_main_5g'
	option device 'radio1'
	option mode 'ap'
	option network 'vlan30'
	option ssid '{{ wifi_main_ssid | default("Homelab-Main") }}'
	option encryption 'sae-mixed'
	option key '{{ wifi_main_password }}'
	option ieee80211w '1'
	option ieee80211k '1'
	option ieee80211v '1'
	option hidden '0'
	option isolate '0'
	option mcast_to_unicast '1'
	option disassoc_low_ack '1'

# =====================================================================
# VLAN 40 - IOT (Exclusivamente 2.4GHz, OCULTO, Client Isolation)
# =====================================================================
config wifi-iface 'wifi_iot_2g'
	option device 'radio0'
	option mode 'ap'
	option network 'vlan40'
	option ssid '{{ wifi_iot_ssid | default("Homelab-IoT") }}'
	option encryption 'psk2'
	option key '{{ wifi_iot_password }}'
	option hidden '1'
	option isolate '1'

# =====================================================================
# VLAN 60 - MEDIA (Exclusivamente 5GHz, OCULTO, QoS Video/WMM)
# =====================================================================
config wifi-iface 'wifi_media_5g'
	option device 'radio1'
	option mode 'ap'
	option network 'vlan60'
	option ssid '{{ wifi_media_ssid | default("Homelab-Media") }}'
	option encryption 'psk2+ccmp'
	option key '{{ wifi_media_password }}'
	option hidden '1'
	option isolate '0'
	option wmm '1'
	option mcast_rate '24000'
	option mcast_to_unicast '1'

# =====================================================================
# VLAN 50 - GUEST (Dual-Band 2.4GHz + 5GHz, Visivel, Client Isolation)
# =====================================================================
config wifi-iface 'wifi_guest_2g'
	option device 'radio0'
	option mode 'ap'
	option network 'vlan50'
	option ssid '{{ wifi_guest_ssid | default("Homelab-Guest") }}'
	option encryption 'psk2'
	option key '{{ wifi_guest_password }}'
	option hidden '0'
	option isolate '1'

config wifi-iface 'wifi_guest_5g'
	option device 'radio1'
	option mode 'ap'
	option network 'vlan50'
	option ssid '{{ wifi_guest_ssid | default("Homelab-Guest") }}'
	option encryption 'psk2'
	option key '{{ wifi_guest_password }}'
	option hidden '0'
	option isolate '1'
