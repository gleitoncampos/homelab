config system
	option hostname '{{ openwrt_hostname | default('openwrt-ap') }}'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'
	option compat_version '1.0'
	option zonename '{{ network_timezone | default('America/Sao_Paulo') }}'
	option log_proto '{{ syslog_protocol | default('udp') }}'
	option conloglevel '8'
	option cronloglevel '5'
	option log_ip '{{ syslog_server_ip }}'
	option log_port '{{ syslog_server_port | default('1514') }}'
	option timezone '<-03>3'
	option packet_steering '1'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
{% for ntp in ntp_servers | default(['a.st1.ntp.br', 'b.st1.ntp.br', 'c.st1.ntp.br', 'd.st1.ntp.br']) %}
	list server '{{ ntp }}'
{% endfor %}

config dropbear
	option PasswordAuth 'off'
	option RootPasswordAuth 'off'
	option Port '2222'
	option Interface 'vlan10'
	option RootKeyOnly '1'

config uhttpd 'main'
	list listen_http '0.0.0.0:80'
	list listen_https '0.0.0.0:443'
	option redirect_https '1'
	option cert '/etc/uhttpd.crt'
	option key '/etc/uhttpd.key'

{#
  Mantem MUDOS os LEDs de atividade wifi. Sem estas seccoes o trigger de
  fabrica (phy0tpt/phy1tpt) volta a cada reboot, e a atividade wifi passa a
  poluir a cor do sinal de saude -- os LEDs de status dividem o difusor com
  eles, entao "piscar com o trafego" vira ruido em cima do sinal.

  Quem aplica isto e o /etc/init.d/led (START=96), antes do led-health
  (START=97). A ordem esta documentada no init do daemon.
#}
{% for l in openwrt_led_silenced | default(['mt76-phy0', 'mt76-phy1']) %}
config led 'led_mudo_{{ loop.index }}'
	option name 'Silenciado pelo led-health ({{ l }})'
	option sysfs '{{ l }}'
	option trigger 'none'
	option default '0'
{% endfor %}
