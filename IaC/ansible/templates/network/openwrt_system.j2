config system
	option hostname '{{ openwrt_hostname }}'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'
	option compat_version '1.0'
	option zonename '{{ network_timezone | default('America/Sao_Paulo') }}'
	option log_proto '{{ syslog_protocol | default('udp') }}'
	option conloglevel '8'
	option cronloglevel '5'
	option log_ip '{{ syslog_server_ip }}'
	option log_port '{{ syslog_server_port | default('1514') }}'
	option timezone '<-03>3'
	option packet_steering '1'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
{% for ntp in ntp_servers | default(['a.st1.ntp.br', 'b.st1.ntp.br', 'c.st1.ntp.br', 'd.st1.ntp.br']) %}
	list server '{{ ntp }}'
{% endfor %}

{#
  ⚠️ `Interface` AQUI TRANCA O SSH SE A INTERFACE NÃO EXISTIR. Verificado em
  `/etc/init.d/dropbear:145-152`: o `network_get_ipaddrs_all` falha, a função
  faz `return 1` ANTES do `procd_open_instance`, e nenhuma instância nasce —
  não há listener em porta nenhuma. Não é "ignora e escuta em tudo".

  Por isso o nome vem de variável e casa com a interface que o
  `openwrt_network.j2` cria. Mudar um sem o outro é o modo de falha.
  O `procd_add_interface_trigger` do dropbear religa sozinho quando a
  interface aparece, então a ordem entre os dois templates não é crítica —
  a EXISTÊNCIA da interface é.
#}
config dropbear
	option PasswordAuth '{{ openwrt_ssh_password_auth | default('off') }}'
	option RootPasswordAuth '{{ openwrt_ssh_root_password_auth | default('off') }}'
	option Port '{{ openwrt_ssh_port | default('2222') }}'
	option Interface 'vlan{{ openwrt_mgmt_vlan | default(10) }}'
	option RootKeyOnly '{{ openwrt_ssh_root_key_only | default('1') }}'

config uhttpd 'main'
	list listen_http '0.0.0.0:80'
	list listen_https '0.0.0.0:443'
	option redirect_https '1'
	option cert '/etc/uhttpd.crt'
	option key '/etc/uhttpd.key'
