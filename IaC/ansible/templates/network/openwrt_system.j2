config system
	option hostname '{{ openwrt_hostname }}'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'
	option compat_version '1.0'
	option zonename '{{ network_timezone | default('America/Sao_Paulo') }}'
	option log_proto '{{ syslog_protocol | default('udp') }}'
	option conloglevel '8'
	{# 8 = uma linha por job executado. No 5 o crond do busybox logava a cada
	   minuto o wakeup e o reparse do crontab inteiro, tudo como `cron.err`: 516 de
	   768 linhas do logread, empurrando o resto para fora do anel (20/10/2026). #}
	option cronloglevel '8'
	option log_ip '{{ syslog_server_ip }}'
	{# ⚠️ Porta do ouvinte RFC3164, não a mesma dos demais: o `logd` do
	   OpenWrt não fala RFC5424 e não há opção para mudar isso. #}
	option log_port '{{ syslog_server_port_rfc3164 }}'
	option timezone '<-03>3'
	option packet_steering '1'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
{% for ntp in ntp_servers | default(['a.st1.ntp.br', 'b.st1.ntp.br', 'c.st1.ntp.br', 'd.st1.ntp.br']) %}
	list server '{{ ntp }}'
{% endfor %}
