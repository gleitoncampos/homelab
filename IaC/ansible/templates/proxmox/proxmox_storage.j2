dir: local
	path /var/lib/vz
	content iso,vztmpl,backup

lvmthin: local-lvm
	thinpool data
	vgname pve
	content images,rootdir

cifs: NAS_STORAGE
	path /mnt/pve/NAS_STORAGE
	server {{ hostvars[groups['omv'][0]].ansible_host }}
	share {{ proxmox_backup_share }}
	content backup,vztmpl,iso
	prune-backups keep-daily={{ backup_keep_daily }},keep-weekly={{ backup_keep_weekly }}
	username smb
