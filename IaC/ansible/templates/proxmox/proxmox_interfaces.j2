# Network interface configuration for Proxmox VE Host
# Auto-generated by Ansible - 5-VLAN Architecture

auto lo
iface lo inet loopback

iface enp2s0 inet manual

iface enp3s0 inet manual

iface enp4s0 inet manual

# Nota: A porta física enp5s0 é dedicada via PCIe Pass-through (VT-d) para a VM do OPNsense
iface enp5s0 inet manual

# Bridge LAN / Trunk (VLANs 10, 20, 30, 40, 50, 60)
auto vmbr0
iface vmbr0 inet static
	address {{ ansible_host }}/24
	gateway {{ (vlans | selectattr('tag', 'equalto', 10) | first).ip }}
	bridge-ports enp2s0 enp3s0 enp4s0
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes

source /etc/network/interfaces.d/*
