# Network interface configuration for Proxmox VE Host
# Auto-generated by Ansible — NÃO editar à mão: este arquivo é reescrito
# inteiro na próxima execução de playbooks/00-proxmox-setup.yml.
{#
  As portas da bridge são DERIVADAS dos facts do host, não escritas à mão. A
  versão anterior fixava enp2s0/enp3s0/enp4s0 em literal, o que só era verdade
  no nó primário — no secundário, com nomes de interface diferentes, este
  arquivo tiraria o host da rede sem que nada no playbook acusasse.

  Nomes aceitos: `en*`/`eth*` (PVE 8) e `nicN` (PVE 9, que fixa os nomes
  por .link em /usr/local/lib/systemd/network/). O `$` exclui subinterface
  com ponto — `nic0.20` é a VLAN que o próprio Proxmox cria enquanto a bridge
  não é VLAN-aware, e virar porta da bridge derrubaria a rede.

  Excluídas da bridge: a loopback, as interfaces virtuais criadas pelo próprio
  Proxmox (vmbr/tap/veth/fw/bond) e a NIC de WAN, que é dedicada à VM do
  firewall via PCIe pass-through. A WAN só precisa ser declarada em
  `proxmox_wan_interface` enquanto o pass-through ainda não está ativo: depois
  disso ela some dos facts do host, porque pertence ao vfio.

  O gateway vem de `proxmox_gateway_ip`, e NÃO de `vlans`: essa variável vive
  em group_vars/network/, que só se aplica aos hosts dos grupos opnsense e
  openwrt. Um host do grupo `proxmox` nunca a enxerga — usá-la aqui rendia
  "'vlans' is undefined" na primeira execução real contra um hipervisor.
-#}
{% set fisicas = ansible_interfaces
     | select('match', '^(en|eth|nic)[a-z0-9]+$')
     | reject('equalto', proxmox_wan_interface | default(''))
     | sort %}

auto lo
iface lo inet loopback

{% for nic in fisicas %}
iface {{ nic }} inet manual

{% endfor %}
{% if proxmox_wan_interface is defined and proxmox_wan_interface %}
# Dedicada via PCIe pass-through (VT-d) à VM do firewall — fora da bridge.
iface {{ proxmox_wan_interface }} inet manual

{% endif %}
# Bridge LAN / Trunk — VLAN-aware, entrega os frames taggeados ao firewall
auto vmbr0
iface vmbr0 inet static
	address {{ ansible_host }}/{{ proxmox_lan_prefix | default(24) }}
	gateway {{ proxmox_gateway_ip }}
	bridge-ports {{ fisicas | join(' ') }}
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094

source /etc/network/interfaces.d/*
