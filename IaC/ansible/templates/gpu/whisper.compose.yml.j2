# Gerado por Ansible (08-gpu-host.yml). Sobe sob demanda: `docker compose up -d`.
services:
  whisper:
    image: {{ gpu_ferramentas.whisper.image }}
    restart: "no"
    ports:
      - "{{ gpu_ip_estatico }}:{{ gpu_ferramentas.whisper.porta }}:{{ gpu_ferramentas.whisper.porta_container }}"
    volumes:
      - {{ gpu_dir }}/whisper/modelos:/home/ubuntu/.cache/huggingface/hub
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
