{# /etc/nut/ups.conf — gerado pelo Ansible (07-nut-ups.yml). Não editar à mão. #}
# Quantas vezes o upsdrvctl tenta subir o driver antes de desistir.
maxretry = 3

[{{ nut_ups_name }}]
  driver = ragtech
  # Symlink estável do udev, não /dev/ttyACM0: a numeração muda se outro
  # dispositivo CDC-ACM enumerar antes no boot.
  port = {{ nut_device_symlink }}
  desc = "Nobreak do rack"
  pollinterval = 5
{% if nut_allow_shutdown | bool %}
  # ⚠️ Habilitado por decisão explícita (nut_allow_shutdown).
  #
  # MEDIDO: o man page do driver afirma que o firmware do Easy 2000 TI NÃO
  # religa sozinho depois de um desligamento coordenado — volta só com o
  # botão físico.
  #
  # PRESUNÇÃO: os demais modelos da família compartilham protocolo e
  # registradores, mas só o 2000 TI foi validado ponta a ponta. Confira o
  # comportamento do SEU modelo antes de contar com ele.
  allow_shutdown
{% endif %}
