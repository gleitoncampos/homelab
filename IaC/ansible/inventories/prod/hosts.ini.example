[homelab_managers]
node1 ansible_host=<IP-DO-MANAGER> ansible_user=nuvidio

[homelab_workers]
node2 ansible_host=<IP-DO-WORKER-1> ansible_user=nuvidio

[opnsense]
# opnsense ansible_host=<IP-DA-OPNSENSE> ansible_user=root

[openwrt]
# openwrt ansible_host=<IP-DO-OPENWRT> ansible_user=root ansible_shell_type=sh

[proxmox]
# hypervisor1 ansible_host=<IP-DO-HYPERVISOR-1> ansible_user=root
# hypervisor2 ansible_host=<IP-DO-HYPERVISOR-2> ansible_user=root

[omv]
# omv ansible_host=<IP-DO-OMV> ansible_user=root

[homelab:children]
homelab_managers
homelab_workers

[network:children]
opnsense
openwrt

[all:vars]
# Servidor NTP interno — normalmente o firewall, que costuma ser também o
# gateway. OPCIONAL: enquanto ele não roteia, ou está sem o serviço de tempo
# ligado, deixe comentado e só as fontes públicas do ntp.br valem (definidas em
# inventories/_common/all.yml). Ter as duas é de propósito: relógio sem fonte
# não dá erro, derrapa devagar até virar falha de TLS semanas depois.
# ntp_server_internal=<IP-DO-FIREWALL>

# VMID da VM que roda o Swarm inteiro (playbooks/06-backup.yml). OBRIGATÓRIO
# para esse playbook — sem default de propósito: um VMID errado faria o
# vzdump salvar a máquina errada e reportar sucesso.
# backup_vmid_swarm=<VMID-DA-VM-DO-SWARM>

# Nome do storage do Proxmox com `content backup` (verificar com
# `pvesm status`). OBRIGATÓRIO para playbooks/06-backup.yml — sem default
# porque os dois nós Proxmox hoje referenciam o mesmo share por nomes
# diferentes; ver docs/ROADMAP.md, secção 2.3.
# backup_storage=<NOME-DO-STORAGE-DE-BACKUP>

# Faixa autorizada a alcançar as portas administrativas publicadas pelo Docker
# (9000 do Portainer, 1514 do syslog). O UFW NÃO fecha essas portas: o publish
# faz DNAT em nat/PREROUTING, antes da chain filter. O fecho é em DOCKER-USER.
# Exemplo com faixa de documentação; use a sua.
# mgmt_allowed_cidr=192.0.2.0/24
