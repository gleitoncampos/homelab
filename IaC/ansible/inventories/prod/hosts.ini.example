[homelab_managers]
node1 ansible_host=<IP-DO-MANAGER> ansible_user=nuvidio

[homelab_workers]
node2 ansible_host=<IP-DO-WORKER-1> ansible_user=nuvidio

[opnsense]
# opnsense ansible_host=<IP-DA-OPNSENSE> ansible_user=root

[openwrt]
# openwrt ansible_host=<IP-DO-OPENWRT> ansible_user=root ansible_shell_type=sh

[proxmox]
# hypervisor1 ansible_host=<IP-DO-HYPERVISOR-1> ansible_user=root
# hypervisor2 ansible_host=<IP-DO-HYPERVISOR-2> ansible_user=root

[omv]
# omv ansible_host=<IP-DO-OMV> ansible_user=root

[homelab:children]
homelab_managers
homelab_workers

[network:children]
opnsense
openwrt

[all:vars]
# Servidor NTP interno — normalmente o firewall, que costuma ser também o
# gateway. OPCIONAL: enquanto ele não roteia, ou está sem o serviço de tempo
# ligado, deixe comentado e só as fontes públicas do ntp.br valem (definidas em
# inventories/_common/all.yml). Ter as duas é de propósito: relógio sem fonte
# não dá erro, derrapa devagar até virar falha de TLS semanas depois.
# ntp_server_internal=<IP-DO-FIREWALL>

# Lista de VMIDs dos convidados do Proxmox (VM QEMU e CT LXC) que entram no
# backup agendado (playbooks/06-backup.yml). OBRIGATÓRIO para esse playbook
# — sem default de propósito: uma lista errada faria o vzdump salvar o
# convidado errado e reportar sucesso. Formato de lista em colchetes — o
# parser INI do Ansible interpreta como lista Python de verdade, não como
# string; sem os colchetes vira uma string só, não uma lista.
# backup_vmids=[<VMID-1>,<VMID-2>,<VMID-3>]

# Id do storage de backup NESTE nó (o que `pvesm status` mostra ali).
# OBRIGATÓRIO para playbooks/06-backup.yml E para playbooks/00-proxmox-setup.yml,
# que escreve o storage.cfg — é o mesmo id nas duas pontas do mesmo host, de
# propósito: o playbook agenda o vzdump contra o id que o template acabou de
# declarar.
#
# ⚠️ Vai na LINHA DO HOST, não em [all:vars]: os dois nós Proxmox registram o
# mesmo share do NAS com nomes diferentes. Global, o storage.cfg do secundário
# sairia declarando o id do primário. Ex.:
#   hypervisor1 ansible_host=<IP> ansible_user=root backup_storage=<ID-DO-NO-1>

# Gateway do hipervisor na rede de HOJE. OBRIGATÓRIO para
# playbooks/00-proxmox-setup.yml quando o firewall já existe: é o gateway que
# ele escreve em /etc/network/interfaces. Não deriva de `vlans` — essa variável
# vive em group_vars/network/, que só se aplica aos grupos opnsense e openwrt,
# e um host do grupo [proxmox] nunca a enxerga. O `make bootstrap` preenche.
# proxmox_gateway_ip=<IP-DO-GATEWAY>

# Prefixo CIDR da rede de gerência do hipervisor — o /N do `address` de vmbr0
# em /etc/network/interfaces. OPCIONAL: o template usa `| default(24)`, então
# omitir vale /24. ⚠️ O gate de sub-rede em playbooks/00-proxmox-setup.yml HOJE
# só suporta /24 (o assert exige == 24; a checagem de "mesma sub-rede" compara 3
# octetos, válida apenas para /24). Mudar para outro prefixo NÃO é só trocar
# este valor: exige recalcular a rede de verdade (ansible.utils.ipaddr) e
# ajustar aquele gate — não altere sem tratar os dois juntos.
# proxmox_lan_prefix=24

# Interface física de WAN do nó primário, EXCLUÍDA da bridge vmbr0 por ser
# dedicada à VM do firewall via PCIe pass-through. Opcional: vazio faz todas as
# interfaces físicas descobertas nos facts entrarem na bridge.
# proxmox_wan_interface=<NOME-DA-INTERFACE>

# Nome do compartilhamento CIFS no NAS (campo `share` do storage.cfg).
# OBRIGATÓRIO para playbooks/00-proxmox-setup.yml, que renderiza
# templates/proxmox/proxmox_storage.j2 — sem default pelo mesmo motivo do
# backup_storage acima: valor específico do NAS de cada ambiente. O playbook
# aborta por `assert` se faltar.
# proxmox_backup_share=<NOME-DO-COMPARTILHAMENTO-CIFS>

# Faixa autorizada a alcançar as portas administrativas publicadas pelo Docker
# (9000 do Portainer, 1514 do syslog). O UFW NÃO fecha essas portas: o publish
# faz DNAT em nat/PREROUTING, antes da chain filter. O fecho é em DOCKER-USER.
# Exemplo com faixa de documentação; use a sua.
# mgmt_allowed_cidr=192.0.2.0/24
