{#
  Configuração do Alloy que roda no CT central de rsyslog — FORA do Swarm.

  Não confundir com `config.alloy`, que é o Alloy da stack `monitoring`: aquele
  recebe syslog pela rede e lê os containers locais; este lê os ARQUIVOS que o
  rsyslog do CT já gravou, um por equipamento.

  ⚠️ Todo nome de job e todo caminho de arquivo derivam do `inventory_hostname`
  do inventário. Nada de hostname literal: este arquivo é versionado e público.

  ⚠️ Nenhum playbook entrega este template hoje — o CT de rsyslog ainda não está
  no inventário. Ele existe aqui para que a configuração real deixe de viver só
  dentro do CT. Ver `docker/monitoring/README.md`.
#}
// ----------------------------------------------------------------------
// 1. MATCH DE ARQUIVOS (DISCOVERY)
// ----------------------------------------------------------------------

// Log do próprio CT.
local.file_match "system" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/syslog",
    job         = "RSYSLOG",
  }]
}

{# ⚠️ O laço vai DENTRO de `path_targets`, nunca em volta do bloco: `local.file_match`
   é um componente com rótulo, e dois blocos com o mesmo rótulo fazem o Alloy
   recusar a configuração inteira. #}
local.file_match "openwrt" {
  path_targets = [
{% for host in groups['openwrt'] | default([]) %}
    {
      __address__ = "localhost",
      __path__    = "/var/log/rsyslog/openwrt/{{ host }}.log",
      job         = "{{ host | upper }}",
    },
{% endfor %}
  ]
}

{# O caminho do OPNsense é um glob e NÃO varia por host — o rsyslog grava um
   arquivo por facility, não por equipamento. Repetir o mesmo glob por host
   faria o Alloy ler cada linha duas vezes. Com um firewall só, o rótulo é o
   nome dele; com mais de um, um rótulo genérico, porque não há como separar. #}
{% set firewalls = groups['opnsense'] | default([]) %}
local.file_match "opnsense" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/rsyslog/opnsense/*.log",
    job         = "{{ (firewalls | first | upper) if firewalls | length == 1 else 'OPNSENSE' }}",
  }]
}

local.file_match "omv" {
  path_targets = [
{% for host in groups['omv'] | default([]) %}
    {
      __address__ = "localhost",
      __path__    = "/var/log/rsyslog/omv/{{ host }}.log",
      job         = "{{ host | upper }}",
    },
{% endfor %}
  ]
}

local.file_match "proxmox" {
  path_targets = [
{% for host in groups['proxmox'] | default([]) %}
    {
      __address__ = "localhost",
      __path__    = "/var/log/rsyslog/pve/{{ host }}.log",
      job         = "{{ host | upper }}",
    },
{% endfor %}
  ]
}

{# ⚠️ Este bloco era o único com hostname LITERAL no arquivo, contrariando o
   aviso do cabeçalho — e o arquivo é versionado num repositório público. Agora
   segue o mesmo laço dos demais: um alvo por nó manager, caminho e rótulo
   derivados do `inventory_hostname`. O rótulo passou a ser maiúsculo como o de
   todo bloco vizinho; nenhum dashboard filtrava pelo valor antigo. #}
// VM que hospeda o Swarm, cujo log chega por serial/console.
local.file_match "docker_critical" {
  path_targets = [
{% for host in groups['homelab_managers'] | default([]) %}
    {
      __address__ = "localhost",
      __path__    = "/var/log/vm/{{ host }}.log",
      job         = "{{ host | upper }}",
    },
{% endfor %}
  ]
}

// ----------------------------------------------------------------------
// 2. PIPELINES DE PROCESSAMENTO (PARSERS & LABELS)
// ----------------------------------------------------------------------

loki.process "opnsense_pipeline" {
  forward_to = [loki.write.default.receiver]

  // Serviço principal (unbound, filterlog, etc).
  stage.regex {
    expression = "(?P<service>unbound|filterlog|dhcpd|kernel|system)"
  }

  // Tipo de consulta DNS, tratando query e reply.
  stage.regex {
    expression = "(reply|query):\\s+\\S+\\s+\\S+\\s+(?P<dns_type>A|AAAA|TXT|MX|CNAME|PTR)"
  }

  // Força level="info": sem isso o NOERROR do unbound vira ERRO no Grafana.
  stage.static_labels {
    values = {
      level = "info",
    }
  }

  stage.labels {
    values = {
      service  = "service",
      dns_type = "dns_type",
      level    = "level",
    }
  }
}

loki.process "proxmox_pipeline" {
  forward_to = [loki.write.default.receiver]

  stage.regex {
    expression = "^(?P<time>\\S+\\s+\\d+\\s+\\d+:\\d+:\\d+)\\s+(?P<host>\\S+)\\s+(?P<service>[^\\[\\:]+)(\\[(?P<pid>\\d+)\\])?:\\s+((?P<level>INFO|WARNING|ERROR|CRITICAL):)?\\s*(?P<message>.*)$"
  }

  stage.labels {
    values = {
      service = "service",
      level   = "level",
    }
  }
}

loki.process "openwrt_pipeline" {
  forward_to = [loki.write.default.receiver]

  stage.regex {
    expression = "^(?P<time>\\S+\\s+\\d+\\s+\\d+:\\d+:\\d+)\\s+(?P<host>\\S+)\\s+(?P<facility>daemon|kern|user)\\.(?P<level>err|warn|info|notice|debug)\\s+(?P<service>[^:]+):"
  }

  stage.labels {
    values = {
      service = "service",
      level   = "level",
    }
  }
}

loki.process "docker_pipeline" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      log    = "log",
      stream = "stream",
    }
  }

  stage.labels {
    values = {
      stream = "stream",
    }
  }

  stage.output {
    source = "log"
  }
}

// ----------------------------------------------------------------------
// 3. COLETA DOS LOGS (SOURCES)
// ----------------------------------------------------------------------

loki.source.file "opnsense" {
  targets               = local.file_match.opnsense.targets
  forward_to            = [loki.process.opnsense_pipeline.receiver]
  legacy_positions_file = "/tmp/positions.yaml"
}

loki.source.file "proxmox" {
  targets               = local.file_match.proxmox.targets
  forward_to            = [loki.process.proxmox_pipeline.receiver]
  legacy_positions_file = "/tmp/positions.yaml"
}

loki.source.file "openwrt" {
  targets               = local.file_match.openwrt.targets
  forward_to            = [loki.process.openwrt_pipeline.receiver]
  legacy_positions_file = "/tmp/positions.yaml"
}

loki.source.file "docker_critical" {
  targets               = local.file_match.docker_critical.targets
  forward_to            = [loki.process.docker_pipeline.receiver]
  legacy_positions_file = "/tmp/positions.yaml"
}

// Sem pipeline dedicado.
loki.source.file "system_and_omv" {
  targets = array.concat(
    local.file_match.system.targets,
    local.file_match.omv.targets,
  )
  forward_to            = [loki.write.default.receiver]
  legacy_positions_file = "/tmp/positions.yaml"
}

// ----------------------------------------------------------------------
// 4. EXPORTADOR LOKI (WRITE)
// ----------------------------------------------------------------------

// Endereço do Loki na LAN. Este CT está fora da rede overlay do Swarm, então
// não resolve `tasks.monitoring_loki` — precisa do endereço do nó, vindo do
// inventário.
loki.write "default" {
  endpoint {
    url = "{{ loki_push_url }}"

    batch_size = "1MB"
    batch_wait = "1s"

    min_backoff_period  = "500ms"
    max_backoff_period  = "5s"
    max_backoff_retries = 10
  }
}
