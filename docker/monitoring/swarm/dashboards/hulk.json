{
  "annotations": {
    "list": []
  },
  "description": "Servidor de GPU sob demanda (hulk): CPU, RAM, disco, GPU, VRAM e temperaturas. Desligado = sem dado.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Visão geral",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Hulk",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "pluginVersion": "12.2.0",
      "description": "Sob demanda: desligado aparece como DESLIGADO (alvo down), não é falha.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DESLIGADO",
                  "color": "dark-red"
                },
                "1": {
                  "text": "LIGADO",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "editorMode": "code",
          "expr": "up{job=\"node_exporter\",instance=\"HULK\"}",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "gauge",
