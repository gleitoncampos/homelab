    {
      "type": "timeseries",
      "title": "Gateway do provedor (dpinger do firewall)",
      "description": "RTT e perda medidos pelo próprio firewall contra o next-hop da WAN. Perda alta aqui = problema no link do provedor.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "opnsense_gateway_rtt_seconds{job=\"opnsense\"}",
          "legendFormat": "RTT {{gateway}}",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "opnsense_gateway_loss_ratio{job=\"opnsense\"}",
          "legendFormat": "perda {{gateway}}",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "perda .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
