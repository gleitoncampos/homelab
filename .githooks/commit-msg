#!/usr/bin/env bash
#
# commit-msg — Conventional Commits.
#
# A convenção já era seguida de fato antes deste hook existir; ele só impede a
# deriva. O valor concreto vem depois: changelog gerado, versão derivada do tipo
# de mudança, e histórico em que dá para achar "toda alteração de segurança"
# com um grep.
#
# Instalar:  git config core.hooksPath .githooks

set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
MSG_FILE="$1"

# ---------------------------------------------------------------------------
# Vazamento na MENSAGEM
# ---------------------------------------------------------------------------
# A mensagem é publicada junto com o diff e, ao contrário do arquivo, não tem
# como ser corrigida depois sem reescrever o histórico. Varrer só o conteúdo dos
# arquivos era meia proteção: este hook nasceu porque um hostname real foi
# escrito numa mensagem descrevendo justamente a varredura de hostnames.
#
# Sem isenção por caminho aqui — mensagem não tem caminho, e não existe motivo
# legítimo para um segredo aparecer numa.
# shellcheck source=.githooks/lib.sh
. "$REPO/.githooks/lib.sh"

BODY="$(grep -vE '^[[:space:]]*#' "$MSG_FILE")"
leaked=0
while IFS= read -r line; do
  split_pattern "$line" || continue
  hits="$(grep -iE -e "$P_REGEX" <<<"$BODY" || true)"
  if [[ -n "$hits" ]]; then
    printf '\n\033[31m✗\033[0m Dado sensível na mensagem de commit: %s\n' "$P_LABEL" >&2
    printf '%s\n' "$hits" | head -2 | cut -c1-110 | sed 's/^/      /' >&2
    leaked=1
  fi
done < <(pattern_lines "$REPO")

if (( leaked )); then
  cat >&2 <<'TXT'

  A mensagem vai para o histórico público junto com o diff, e corrigi-la depois
  exige reescrever o histórico. Reescreva a mensagem sem o termo — descreva o
  papel do host ("o nó manager", "o firewall") em vez do nome.

TXT
  exit 1
fi

# Ignora comentários e a mensagem gerada por merge/revert/fixup.
SUBJECT="$(grep -vE '^[[:space:]]*#' "$MSG_FILE" | grep -vE '^[[:space:]]*$' | head -1)"

case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security'
PATTERN="^(${TYPES})(\([a-z0-9._/-]+\))?!?: .{1,}$"

fail() {
  cat >&2 <<TXT

✗ Mensagem de commit fora do padrão Conventional Commits.

  recebido: ${SUBJECT:-<vazio>}
  esperado: <tipo>(<escopo opcional>): <descrição>

  tipos: feat fix docs style refactor perf test build ci chore revert security
  exemplos:
    feat(ansible): injeta o env das stacks pela API do Portainer
    fix: remove o ignore_errors que mascarava falha de deploy
    docs(readme): corrige os caminhos após o agrupamento em IaC/

  Use ! antes dos dois pontos para mudança incompatível: feat(iac)!: ...
  Pular esta checagem: git commit --no-verify

TXT
  exit 1
}

[[ "$SUBJECT" =~ $PATTERN ]] || fail

# O assunto é o que aparece em `git log --oneline` e nas listagens do GitHub;
# acima de 72 caracteres ele é truncado justamente onde estaria a informação.
if (( ${#SUBJECT} > 72 )); then
  printf '\n✗ Assunto com %d caracteres (máximo 72):\n  %s\n\n' "${#SUBJECT}" "$SUBJECT" >&2
  printf '  O corpo da mensagem não tem limite — mova o detalhe para lá.\n\n' >&2
  exit 1
fi

# Imperativo, não passado: "adiciona", não "adicionado".
DESC="${SUBJECT#*: }"
if [[ "$DESC" =~ ^[[:alpha:]]+(ado|ada|ados|adas|ido|ida|idos|idas)[[:space:]] ]]; then
  printf '\n⚠ A descrição parece estar no particípio: "%s"\n' "${DESC%% *}" >&2
  printf '  A convenção pede imperativo — "adiciona", não "adicionado".\n' >&2
  printf '  Isto é só um aviso; o commit segue.\n\n' >&2
fi
